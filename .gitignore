# Editor
.idea/
.vscode/
*.swp

# Python (label-rules.py compiles to .pyc on import in CI)
__pycache__/
*.pyc

# Local config (never commit)
.trail/

# Build artifacts populated by build.rs (NOT source — see §1.10)
src-tauri/resources/trail-collector
src-tauri/resources/day-summary.schema.json
# Phase 2 §2.2 — github.schema.json + the future §2.3 / §2.4 schemas
# are rebuilt from crates/trail-collector/schemas/ on every cargo build.
src-tauri/resources/github.schema.json
src-tauri/resources/claude_sessions.schema.json
src-tauri/resources/calendar.schema.json

# Phase 9 §9.3 — cargo test scratch dir created by the
# `headless_launch_*` integration tests (the `tempfile::tempdir`
# helper in Tauri 2's test framework writes here, not to the
# system tempdir, on some platforms). Per §5b D8, never commit.
src-tauri/.local/
