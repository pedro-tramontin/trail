{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrailRawBrowserHistory",
  "type": "object",
  "required": ["source", "captured_at", "date", "payload"],
  "properties": {
    "source":      { "type": "string", "enum": ["browser_history"] },
    "captured_at": { "type": "string", "format": "date-time" },
    "date":        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "payload": {
      "type": "object",
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "title", "last_visit_time",
                         "visit_count", "browser", "profile"],
            "properties": {
              "url":             { "type": "string" },
              "title":           { "type": "string" },
              "last_visit_time": { "type": "string",
                                   "format": "date-time" },
              "visit_count":     { "type": "integer", "minimum": 0 },
              "browser":         { "enum": ["chrome", "brave",
                                            "opera", "firefox",
                                            "safari"] },
              "profile":         { "type": "string" },
              "transition_type": {
                "type": ["string", "null"],
                "enum": ["link", "typed", "auto_bookmark",
                         "auto_subframe", "manual_subframe",
                         "generated", "start_page",
                         "form_submit", "reload", "keyword",
                         "keyword_generated", "redirect",
                         "deep_link", "other", null]
              },
              "typed_count":     { "type": ["integer", "null"],
                                   "minimum": 0 },
              "referrer_url":    { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}