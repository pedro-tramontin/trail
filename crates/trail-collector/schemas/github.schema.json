{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrailRawGithub",
  "type": "object",
  "required": ["source", "captured_at", "date", "payload"],
  "additionalProperties": false,
  "properties": {
    "source":      { "type": "string", "enum": ["github"] },
    "captured_at": { "type": "string", "format": "date-time" },
    "date":        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "payload": {
      "type": "object",
      "required": ["author", "since", "until", "prs"],
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string" },
        "since":  { "type": "string", "format": "date-time" },
        "until":  { "type": "string", "format": "date-time" },
        "prs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["number", "title", "state", "url", "created_at", "updated_at", "events", "commits"],
            "additionalProperties": false,
            "properties": {
              "number":     { "type": "integer" },
              "title":      { "type": "string" },
              "state":      { "type": "string", "enum": ["open", "closed", "merged"] },
              "url":        { "type": "string", "format": "uri" },
              "created_at": { "type": "string", "format": "date-time" },
              "updated_at": { "type": "string", "format": "date-time" },
              "merged_at":  { "type": ["string", "null"], "format": "date-time" },
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "at"],
                  "additionalProperties": false,
                  "properties": {
                    "type": { "type": "string", "enum": ["opened", "reviewed", "commented", "merged", "closed"] },
                    "at":   { "type": "string", "format": "date-time" },
                    "by":   { "type": ["string", "null"] }
                  }
                }
              },
              "commits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["sha", "message_headline"],
                  "additionalProperties": false,
                  "properties": {
                    "sha":              { "type": "string" },
                    "message_headline": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
