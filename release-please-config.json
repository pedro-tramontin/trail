{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "src-tauri": {
      "component": "trail",
      "package-name": "trail-app",
      "release-type": "rust",
      "bump-patch-for-minor-pre-major": true,
      "bump-minor-for-minor-pre-major": false,
      "changelog-path": "CHANGELOG.md",
      "pull-request-title-pattern": "release: v${version}"
    },
    "crates/trail-collector": {
      "component": "trail-collector",
      "package-name": "trail-collector",
      "release-type": "rust",
      "bump-patch-for-minor-pre-major": true,
      "bump-minor-for-minor-pre-major": false,
      "changelog-path": "CHANGELOG.md",
      "pull-request-title-pattern": "release(collector): v${version}"
    }
  },
  "extra-files": [
    {
      "type": "json",
      "path": "/src-tauri/tauri.conf.json",
      "jsonpath": "$.version"
    },
    {
      "type": "json",
      "path": "/package.json",
      "jsonpath": "$.version"
    }
  ],
  "release-labels": ["autorelease: pending"],
  "prerelease": true,
  "prerelease-type": "pre",
  "draft": false,
  "include-v-in-tag": true,
  "include-component-in-tag": true,
  "tag-separator": "-"
}
